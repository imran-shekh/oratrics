// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  role  Role

  demos Demo[]
}

model Lead {
  id               Int      @id @default(autoincrement())
  parent_name      String
  child_grade      String
  program_interest Program
  status           LeadStatus @default(NEW)

  demos Demo[]
}

model Demo {
  id                 Int      @id @default(autoincrement())
  scheduled_datetime DateTime
  teacher_name       String
  outcome            DemoOutcome?

  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id])

  userId Int?
  user   User? @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  SALES
  TEACHER
}

enum Program {
  MATH
  PERSONALITY
}

enum LeadStatus {
  NEW
  DEMO_SCHEDULED
  DEMO_COMPLETED
  CONVERTED
}

enum DemoOutcome {
  COMPLETED
  NO_SHOW
  CONVERTED
}

